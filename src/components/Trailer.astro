---
interface Props {
  videoId: string;
  game: string;
}
const { videoId, game } = Astro.props;
---
<section class="section trailer" aria-labelledby="trailer-title">
  <div class="section-top">
    <h2 id="trailer-title">Watch the trailer</h2>
    <a class="text-link" href={'https://www.youtube.com/watch?v=' + videoId}>Watch on YouTube ↗</a>
  </div>
  <iframe
    src={'https://www.youtube-nocookie.com/embed/' + videoId}
    title={game + ' trailer'}
    width="1280"
    height="720"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</section>
<style>
  .trailer h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
  iframe { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border: 1px solid var(--line); background: #050805; }
  @media (max-width: 680px) {
    .trailer .section-top { flex-direction: column; gap: 15px; }
  }
</style>
